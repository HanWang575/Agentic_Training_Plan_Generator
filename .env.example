APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EVAL_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# Chat/LLM provider. If LLM_* is set, answer generation uses this
# OpenAI-compatible provider instead of OPENAI_API_KEY.
LLM_MODEL_TYPE=aihubmix
LLM_MODEL_ID=gpt-5.4-mini
LLM_API_KEY=
LLM_BASE_URL=https://aihubmix.com/v1

# Embedding provider. Use `openai` or `dashscope`.
EMBED_MODEL_TYPE=openai
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_DIMENSIONS=

# DashScope / Aliyun example:
# EMBED_MODEL_TYPE=dashscope
# EMBED_MODEL_NAME=text-embedding-v3
# EMBED_API_KEY=your_dashscope_api_key
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SQLITE_PATH=data/app.sqlite
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=qa_approved_chunks_v1

UPLOAD_DIR=data/uploads
RAG_CORPUS_DIR=RAG_corpus
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
KEYWORD_TOP_K=30
SEMANTIC_TOP_K=30
FINAL_CONTEXT_TOP_K=12
MAX_CONTEXT_TOKENS=12000
ANSWER_MAX_TOKENS=1000
HYBRID_RRF_K=60
EMBEDDING_BATCH_SIZE=10
